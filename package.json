{
  "name": "bailey-hall-evacuation",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Agent-based evacuation simulator for Bailey Hall (CMCM 2026, Bail(ey)ing Out)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "geometry": "tsx scripts/generate-geometry.ts",
    "batch": "tsx scripts/batch.ts",
    "experiments": "tsx scripts/run-experiments.ts",
    "compare": "tsx scripts/compare-experiments.ts",
    "flow": "tsx scripts/flow-network.ts",
    "network-batch": "tsx scripts/network-batch.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "puppeteer-core": "^23.6.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
